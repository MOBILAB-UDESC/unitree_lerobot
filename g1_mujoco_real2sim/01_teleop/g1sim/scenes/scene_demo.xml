<!--
  Environment for the G1 xr_teleoperate simulation.
  The robot (unitree_mujoco/unitree_robots/g1/g1_29dof.xml), the stereo head cameras and the
  pelvis weld are added by g1_xr_sim.py, so this file only holds the world around the robot.
  Robot stands at the origin facing +x. Bodies with a freejoint are treated as "objects":
  they are reset with key 0 and their poses are published on rt/sim_state.
-->
<mujoco model="g1_xr_env">
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-150" elevation="-20" offwidth="1280" offheight="960"/>
    <!-- 4096 shadow maps cost ~40 ms per stereo frame on an AMD iGPU; 2048 + one shadow light ~12 ms -->
    <quality shadowsize="2048"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="table_top" rgba="0.55 0.4 0.28 1"/>
    <material name="table_leg" rgba="0.3 0.3 0.3 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <light pos="1.5 -1 2.5" dir="-0.5 0.3 -1" diffuse="0.4 0.4 0.4" castshadow="false"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <body name="table" pos="0.62 0 0">
      <geom name="table_top" type="box" size="0.25 0.5 0.02" pos="0 0 0.70" material="table_top"/>
      <geom type="box" size="0.02 0.02 0.34" pos=" 0.21  0.46 0.34" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.34" pos=" 0.21 -0.46 0.34" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.34" pos="-0.21  0.46 0.34" material="table_leg"/>
      <geom type="box" size="0.02 0.02 0.34" pos="-0.21 -0.46 0.34" material="table_leg"/>
    </body>

    <body name="red_cube" pos="0.45 0.15 0.745">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0.85 0.15 0.15 1" mass="0.08" friction="1.2 0.01 0.001"/>
    </body>
    <body name="green_cube" pos="0.45 -0.15 0.745">
      <freejoint/>
      <geom type="box" size="0.025 0.025 0.025" rgba="0.15 0.75 0.2 1" mass="0.08" friction="1.2 0.01 0.001"/>
    </body>
    <body name="blue_cylinder" pos="0.52 0 0.76">
      <freejoint/>
      <geom type="cylinder" size="0.03 0.04" rgba="0.2 0.35 0.9 1" mass="0.1" friction="1.2 0.01 0.001"/>
    </body>
  </worldbody>
</mujoco>
